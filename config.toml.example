# ESEManager - example config (auto-created as config.toml on first run)

[download]
# Download directory (relative or absolute path)
directory = "Downloads"

# Parallel downloads (1-8). Keep it low to be gentle with the ESE server.
workers = 3

# Where song files come from: "ese" (ese.tjadataba.se), "taiko.ac" (git.taiko.ac mirror)
# or a base URL ending in /media/branch/master/. The other host is used when it fails.
source = "ese"

[display]
# Kept for compatibility (not used by the current GUI)
page_size = 20

# UI language: "auto" (follow system), "zh_TW", "en", "ja"
ui_language = "auto"

# Theme: "auto" (follow system), "light", "dark"
theme = "auto"
